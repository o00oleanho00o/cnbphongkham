{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id626490352"}, "name":{"label":"NFMBUF"}, "label":""}, "updated":{"label":"2026-08-10T08:07:33-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"7.14.0"}, "id":{"label":"14410878130"}, "title":{"label":"DOB entry"}, "content":{"label":"It did not give me the option of entering my date of birth by using the 00/00/0000 selection. I had to go back month by month and year by year scrolling arrows. Since Im 82,  it took me over 900 swipes to get to my dob.  It would be more user friendly if an update would be made. I used my IPhone.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1036175909&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id431411442"}, "name":{"label":"Dwardmn"}, "label":""}, "updated":{"label":"2026-08-07T02:34:36-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"7.14.0"}, "id":{"label":"14398265728"}, "title":{"label":"Awful app"}, "content":{"label":"Absolutely the most frustrating patient portal app I have ever used. I have some minor vision problems and trying to send a message to my doctor is impossible. The app thinks it knows what I want to say and keeps auto filling with words I didn’t add or want.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1036175909&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
