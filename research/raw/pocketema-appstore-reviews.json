{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id345973751"}, "name":{"label":"MiteyJoe"}, "label":""}, "updated":{"label":"2023-08-29T11:32:20-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"7.3.0"}, "id":{"label":"10312959714"}, "title":{"label":"I want my money back"}, "content":{"label":"Nowhere does this app tell you it’s for medical providers and not patients. Further, it charged me for something I can’t even use. How do I get my money back?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=460369272&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
