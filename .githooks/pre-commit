#!/bin/sh
# Blocks a commit that changes visible frontend files (pema-agent/frontend/src/{app,ui,components}) without an entry
# in .claude/skills/pema-web-design/web-design-changes.md. Enable once: git config core.hooksPath .githooks
# Skip for one commit only with the owner's decision: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping the web-design log check" >&2
  exit 0
fi
out=$(node .claude/skills/pema-web-design/scripts/pending-web.cjs 2>&1)
code=$?
if [ "$code" -eq 1 ]; then
  echo "$out" >&2
  echo >&2
  echo "pre-commit: a visible frontend file has no entry under \"Pending\" in .claude/skills/pema-web-design/web-design-changes.md." >&2
  echo "Add the entry (template in that file) and commit again." >&2
  exit 1
fi
exit 0
