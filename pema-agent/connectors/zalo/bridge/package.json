{
  "name": "@pema/zalo-personal-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bun sidecar around zca-js for the Pema personal-account Zalo channel (flag off by default, secondary account only).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kill-switch": "bun scripts/kill-switch.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "pino": "10.3.1",
    "zca-js": "2.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
