{
  "name": "@pema/zalo-personal-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node sidecar around zca-js for the Pema personal-account Zalo channel (flag off by default, secondary account only).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --import ./src/test-setup.ts --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "kill-switch": "tsx scripts/kill-switch.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "image-size": "2.0.4",
    "pino": "10.3.1",
    "zca-js": "2.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0"
  }
}
