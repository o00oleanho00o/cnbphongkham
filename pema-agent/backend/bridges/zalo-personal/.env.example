# zalo-personal bridge (Node sidecar around zca-js). All values are PLACEHOLDERS.
#
# WARNING: zca-js is an unofficial client. Using it can get the Zalo account locked or banned.
# Use a SECONDARY account only. See README.md.

# The bridge is on in the example, but NOTHING runs until an operator scans a QR code (or the API
# pushes a credential through POST /v1/accounts/:id/start). In code the default is false.
PEMA_ZALO_PERSONAL_ENABLED=true

# Shared HMAC secret, at least 16 characters. The API holds the same value (PEMA_ZALO_BRIDGE_SECRET).
# Generate one, for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PEMA_ZALO_BRIDGE_SECRET=change-me-to-a-long-random-secret

# Keep the bridge on loopback. Do not bind it to a public interface.
PEMA_ZALO_BRIDGE_HOST=127.0.0.1
PEMA_ZALO_BRIDGE_PORT=8200

# Where the bridge POSTs its events: {base}/webhooks/zalo-bridge/{clinic_slug}/{account_id}
PEMA_API_BASE_URL=http://localhost:8000/api/v1

# Time zone of the day key of the daily proactive ceiling.
PEMA_BOT_TIMEZONE=Asia/Ho_Chi_Minh

# Hard backstops of the bridge, independent of the API's own caps.
ZALO_BRIDGE_MAX_PROACTIVE_PER_DAY_PER_ACCOUNT=100
ZALO_BRIDGE_MAX_SENDS_PER_MINUTE_PER_ACCOUNT=20
ZALO_BRIDGE_BLOCK_AFTER_REJECTED_SENDS=5

# trace | debug | info | warn | error | fatal | silent
ZALO_BRIDGE_LOG_LEVEL=info
