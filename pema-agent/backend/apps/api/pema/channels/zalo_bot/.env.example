# Zalo Bot channel (package C1). Copy the lines you need into the API process environment (or infra/.env).
# Nothing here is a real value. Never commit a real token.
#
# A bot account's TOKEN is NOT configured here: it is entered on the admin screen (PUT /admin/accounts/{id}/bot-token),
# validated against the Bot API, stored ENCRYPTED with PEMA_SECRET_ENCRYPTION_KEY and never returned by the API.

# polling = getUpdates long poll (default, works behind NAT, nothing to expose)
# webhook = Zalo calls POST {webhook_base_url}/api/v1/webhooks/zalo-bot/{account_id}
# The two are mutually exclusive on the Bot API; an account runs in one mode only.
PEMA_ZALO_BOT_MODE=polling

# Bot API origin. Change only for a mock or a proxy.
PEMA_ZALO_BOT_API_BASE=https://bot-api.zaloplatforms.com

# Webhook mode only: PUBLIC HTTPS origin of this API, no trailing slash. Zalo rejects localhost and private addresses
# (use a tunnel such as ngrok for local development). The webhook secret is derived from PEMA_SECRET_ENCRYPTION_KEY, so
# that key must be set too (64 hex characters, see infra/.env.example).
# PEMA_ZALO_BOT_WEBHOOK_BASE_URL=https://cskh.example.test

# Probe CLI only: python -m pema.channels.zalo_bot.kiem_chung_bot_api
# The token of ONE throwaway test bot, never a clinic's production token. Read from the environment (not argv) so it
# does not show in process lists or shell history.
# PEMA_ZALO_BOT_PROBE_TOKEN=000000000:replace-with-a-test-bot-token

# Shared settings this channel also needs (documented in infra/.env.example, listed here for convenience):
# PEMA_REDIS_URL=redis://localhost:6379/0           batcher, thread lock and turn queue (API process and worker)
# PEMA_SECRET_ENCRYPTION_KEY=<64 hex characters>    encrypts bot tokens, derives the webhook secret
