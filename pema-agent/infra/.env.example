# Copy to infra/.env (never commit it) or generate it with random secrets:  infra/scripts/gen-secrets.sh
# Every value below is a placeholder. Passwords are embedded in URLs: use hex or letters/digits only.
#
# Two kinds of URL exist on purpose:
#   * the PEMA_*_URL variables below point at localhost: for tools you run ON THE HOST (make db-upgrade,
#     make test-db, uv run ... against the published ports);
#   * inside docker compose the services get URLs composed from the passwords (docker-compose.yml,
#     x-backend-env), because there the hosts are `postgres` and `redis`.

# --- Postgres / Redis (docker compose) ------------------------------------------------
PEMA_PG_PORT=5432
PEMA_PG_SUPERUSER_PASSWORD=change-me-superuser
PEMA_REDIS_PORT=6379
PEMA_REDIS_PASSWORD=change-me-redis
# Bind address of the published ports. 127.0.0.1 = this machine only (default, safe). To reach a service from
# the other machine set the machine's TAILSCALE IP (100.x.y.z). Never 0.0.0.0 on a machine with a public IP.
PEMA_PG_BIND=127.0.0.1
PEMA_REDIS_BIND=127.0.0.1
# Memory knobs for a 16-32 GB box that also runs the API; raise shared_buffers on a dedicated DB server.
PEMA_PG_SHARED_BUFFERS=512MB
PEMA_PG_EFFECTIVE_CACHE_SIZE=1536MB
PEMA_REDIS_MAXMEMORY=256mb
# Image tags (pin them for a production box; pgvector tag format is pgNN)
PEMA_PGVECTOR_TAG=pg17
PEMA_REDIS_TAG=7-alpine
PEMA_IMAGE_TAG=local

# Migrations run as the superuser/owner role (scripts/migrate.sh -> alembic upgrade heads):
PEMA_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:change-me-superuser@localhost:5432/pema

# bootstrap-roles.sh (run by migrate.sh) gives the runtime roles a login password. If a password is empty the
# role stays NOLOGIN. Rotate: change the value, `make db-bootstrap`, restart api and worker.
PEMA_BE_APP_PASSWORD=change-me-be-app
PEMA_AGENT_WORKER_PASSWORD=change-me-agent-worker
# true: REVOKE CONNECT on the database from PUBLIC; only be_app and agent_worker (and superusers) may connect.
PEMA_BOOTSTRAP_HARDEN_CONNECT=true

# Runtime URLs for the host side. be_app (API, RLS applies); agent_worker (turns, scheduler, ingest: no
# privilege on clinic.*)
PEMA_DATABASE_URL=postgresql+psycopg://be_app:change-me-be-app@localhost:5432/pema
PEMA_WORKER_DATABASE_URL=postgresql+psycopg://agent_worker:change-me-agent-worker@localhost:5432/pema
PEMA_REDIS_URL=redis://:change-me-redis@localhost:6379/0

# --- API / frontend ---------------------------------------------------------------------
PEMA_ENVIRONMENT=prod
PEMA_API_PORT=8000
PEMA_API_BIND=127.0.0.1
PEMA_FRONTEND_PORT=3000
PEMA_FRONTEND_BIND=127.0.0.1
PEMA_BOT_TIMEZONE=Asia/Ho_Chi_Minh
# Dashboard session: slides 480 minutes after the last use (PEMA_SESSION_TTL_MINUTES, code default) but never past
# this many days after the login (1-30; out of range refuses to start). Read by the API process only.
PEMA_SESSION_ABSOLUTE_DAYS=7

# --- Reverse proxy (profile `proxy`, Caddy: infra/caddy/, infra/README.md "Reverse proxy") ----------------------
# Start: docker compose -f infra/docker-compose.yml -f infra/docker-compose.proxy.yml --env-file infra/.env --profile proxy up -d
# Pick ONE of the three modes (PEMA_PROXY_TLS) and set the matching address (PEMA_PUBLIC_DOMAIN):
#   auto      real domain pointing at this machine; Caddy gets a Let's Encrypt certificate (needs 80 AND 443 open
#             to the internet, PEMA_PROXY_BIND=0.0.0.0 or the public IP).   PEMA_PUBLIC_DOMAIN=clinic.example.com
#   internal  no domain yet; Caddy signs its own certificate (install its CA root on the devices).
#                                                                           PEMA_PUBLIC_DOMAIN=localhost (or pema.lan)
#   off       plain HTTP, ONLY over Tailscale/WireGuard; also set PEMA_SESSION_COOKIE_SECURE=false and
#             PEMA_PROXY_BIND to the Tailscale IP.                          PEMA_PUBLIC_DOMAIN=http://100.64.0.10
PEMA_PROXY_TLS=auto
PEMA_PUBLIC_DOMAIN=localhost
# Loopback by default; the public site needs 0.0.0.0 (or the public IP). Host ports other than 80/443 are for tests.
PEMA_PROXY_BIND=127.0.0.1
PEMA_PROXY_HTTP_PORT=80
PEMA_PROXY_HTTPS_PORT=443
PEMA_CADDY_TAG=2-alpine
# The `edge` network (Caddy, api, frontend only) and Caddy's fixed address on it. The API believes X-Forwarded-For
# only from PEMA_TRUSTED_PROXIES (IPs or CIDRs, comma separated; default = PEMA_PROXY_IP). Change the three together:
# the IP is inside the subnet and OUTSIDE the range (Docker gives api/frontend their addresses only from the range).
PEMA_PROXY_SUBNET=172.29.80.0/24
PEMA_PROXY_IP_RANGE=172.29.80.128/25
PEMA_PROXY_IP=172.29.80.2
# PEMA_TRUSTED_PROXIES=172.29.80.2
PEMA_DASHBOARD_BEHIND_PROXY=true
# Secure session cookie (https only). false ONLY for mode `off`.
PEMA_SESSION_COOKIE_SECURE=true
# Where the dashboard server forwards /api/v1 (read at runtime, no rebuild). Inside compose: the api service.
PEMA_API_INTERNAL_URL=http://api:8000

# --- Secrets ---------------------------------------------------------------------------------
# 64 hex characters (32 bytes) for AES-256-GCM of bot tokens, Zalo credentials, MCP headers, API keys:
#   openssl rand -hex 32
# Losing it makes every stored credential unreadable: keep an offline copy.
PEMA_SECRET_ENCRYPTION_KEY=
PEMA_JWT_SECRET=

# --- Logging ---------------------------------------------------------------------------------
PEMA_LOG_LEVEL=INFO
PEMA_LOG_FILE_ENABLED=false
PEMA_LOG_FILE_KEEP_DAYS=14
PEMA_DATA_DIR=.local/data

# --- Channels --------------------------------------------------------------------------------
# Personal-account mode risks a Zalo account lock (unofficial API): use a SECONDARY account only. The flag is on
# here like in the bridge's own .env.example, but NOTHING runs until the `bridge` compose profile is started and
# an operator scans a QR code in the dashboard; set it to false to turn the whole mode off.
PEMA_ZALO_PERSONAL_ENABLED=true
PEMA_ZALO_BRIDGE_URL=http://localhost:8200
PEMA_ZALO_BRIDGE_SECRET=

# Zalo Bot API: `polling` (the worker long-polls getUpdates) or `webhook` (the API registers the webhook; needs
# a public https address that Zalo can reach, no trailing slash). The two modes exclude each other on Zalo's side.
PEMA_ZALO_BOT_MODE=polling
PEMA_ZALO_BOT_WEBHOOK_BASE_URL=

# --- Knowledge-base embeddings (bge-m3, 1024 dimensions, OpenAI-compatible /embeddings) ----------------------
# Clinic text must stay on the clinic's own machines: the client refuses a public host unless
# PEMA_EMBEDDING_ALLOW_REMOTE=true. Off = keyword search only.
# TẠM TẮT LLM LOCAL (2026-10-02): bge-m3 chạy trên Ollama local, nên tạm tắt embedding. Kho kiến thức chạy
# tìm kiếm từ khóa (Postgres FTS + BM25), đúng như zalo-agent gốc. Bật lại: bỏ dấu # ở 2 dòng dưới và đặt true.
PEMA_EMBEDDING_ENABLED=false
# PEMA_EMBEDDING_BASE_URL=http://ollama:11434/v1
# PEMA_EMBEDDING_MODEL=bge-m3

# --- CRM rules ------------------------------------------------------------------------------------------------
# How often the API process runs the CRM rules for every clinic (seconds; 0 = never, run by hand instead).
PEMA_CRM_RUNNER_INTERVAL_SECONDS=900

# --- LLM (seed values; the dashboard setting in agent.runtime_settings wins, as in zalo-agent) -----------
# Original unprefixed names (src/config/env.ts). Như zalo-agent: gọi API LLM của bên thứ ba. Ưu tiên nhập
# trên dashboard (Quản trị > Model > Nhà cung cấp LLM, key lưu mã hóa trong DB); điền ở đây chỉ để seed.
# Chọn MỘT kiểu kết nối:
#   openai-compatible  router hoặc hãng nói giao thức OpenAI, cần LLM_BASE_URL. Ví dụ:
#                        OpenRouter  https://openrouter.ai/api/v1
#                        OpenAI      https://api.openai.com/v1
#                        DeepSeek    https://api.deepseek.com
#                        9Router / LiteLLM tự host: URL của router
#   anthropic          gọi thẳng api.anthropic.com, để trống LLM_BASE_URL
#   google             gọi thẳng Gemini API, để trống LLM_BASE_URL (KHÔNG dùng lớp giả /v1beta/openai)
# Chế độ patient_channel luôn che PII trước khi gửi LLM; staff_assistant thì không bắt buộc. Gửi qua bên
# thứ ba nghĩa là nội dung hội thoại (đã che với bệnh nhân) rời hạ tầng phòng khám.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# TẠM TẮT LLM LOCAL (2026-10-02): các topology Ollama dưới đây chưa dùng. Bật lại: LLM_BASE_URL trỏ về Ollama,
# LLM_MODEL=pema-chat, bỏ dấu # khối Ollama và bật lại service `ollama` trong docker-compose.yml.
#   Ollama in compose (profile `ollama`)      LLM_BASE_URL=http://ollama:11434/v1
#   Ollama native on the same machine          LLM_BASE_URL=http://host.docker.internal:11434/v1
#       (needs OLLAMA_HOST reachable from the docker bridge: see the Ubuntu guide, section 6)
#   Ollama native on the GPU PC, API on a server  LLM_BASE_URL=http://<tailscale-name-of-the-pc>:11434/v1
# Ollama ignores the key; some clients refuse an empty one, so a dummy is fine.
# LLM_MODEL=pema-chat

# --- Ollama (profile `ollama`, or the native service on the GPU PC) --------------------------------
# TẠM TẮT LLM LOCAL (2026-10-02)
# PEMA_OLLAMA_TAG=latest
# PEMA_OLLAMA_PORT=11434
# PEMA_OLLAMA_BIND=127.0.0.1
# Models: Q5_K_M leaves room for context on 12 GB; Q6_K is closer to Q8 quality (see pull-models.sh).
# PEMA_LLM_MODEL_PULL=hf.co/Qwen/Qwen3-8B-GGUF:Q5_K_M
# PEMA_EMBED_MODEL_PULL=bge-m3
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_CONTEXT_LENGTH=16384
# OLLAMA_KV_CACHE_TYPE=q8_0

# --- Backups (scripts/backup-postgres.sh; see the Ubuntu guide, section 10) ---------------------------
# Encrypt with an age PUBLIC key; keep the private key off this machine.
PEMA_BACKUP_DIR=/var/backups/pema
PEMA_BACKUP_KEEP_DAYS=14
PEMA_BACKUP_AGE_RECIPIENT=
PEMA_BACKUP_GPG_RECIPIENT=

# --- Tuning parameters keep their ORIGINAL (unprefixed) names, e.g.:
# HISTORY_CONTEXT_LIMIT=20
# SCHEDULER_MAX_PROACTIVE_PER_DAY=10
# The full list with defaults and bounds: backend/apps/api/pema/config/tuning_specs.py

# --- Data retention (Decree 13/2023; the clinic owner decides the real periods) -------------------------
# Days per data group; 0 keeps the group forever. Defaults keep clinical data and messages (0) and give only
# purely technical data a short life. The job deletes in small batches per clinic; the API process runs the
# `clinic` scope (clinic.*), the worker the `agent` scope (agent.* and the media files). `clinic.audit_log`,
# patients, appointments, consents and open review items are never deleted.
# docker-compose.yml passes these by name: the API gets the `clinic` scope ones, the worker the `agent` scope
# ones, both get INTERVAL_SECONDS and BATCH_SIZE. TRACE_DAYS and MEDIA_DAYS left unset (or empty) follow the
# dashboard tuning keys AGENT_TRACE_RETENTION_DAYS / MEDIA_RETENTION_DAYS (7 by default).
# One-off / dry run:  docker compose exec api python -m pema.workers.retention --dry-run
#                     docker compose exec worker python -m pema.workers.retention --scope agent --dry-run
# PEMA_RETENTION_INTERVAL_SECONDS=86400
# PEMA_RETENTION_BATCH_SIZE=500
# PEMA_RETENTION_HISTORY_DAYS=0
# PEMA_RETENTION_MEMORY_DAYS=0
# PEMA_RETENTION_MESSAGE_DAYS=0
# PEMA_RETENTION_USAGE_DAYS=0
# PEMA_RETENTION_TRACE_DAYS=
# PEMA_RETENTION_MEDIA_DAYS=
# PEMA_RETENTION_JOB_RUN_DAYS=30
# PEMA_RETENTION_AUTH_SESSION_DAYS=1
# PEMA_RETENTION_LINK_CODE_DAYS=7
# PEMA_RETENTION_LINK_ATTEMPT_DAYS=30
