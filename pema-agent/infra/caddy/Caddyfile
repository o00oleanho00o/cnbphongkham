# Pema Agent: the one public door (compose profile `proxy`). Reads {$PEMA_PUBLIC_DOMAIN} (the site address) and
# imports /etc/caddy/mode.caddy (the TLS mode: auto | internal | off, see infra/caddy/modes/ and infra/README.md).
#
# What is routed, and what never is:
#   /api/v1/*   -> api:8000        (except the Zalo bridge webhook, see below)
#   /healthz    -> api:8000
#   everything else -> frontend:3000 (the Next.js dashboard)
#   Postgres, Redis and the Zalo bridge are NOT routed and cannot be: Caddy is attached only to the `edge` network,
#   where only api and frontend live. /docs, /openapi.json and every other API path fall to the frontend (404).
#
# Caddy is the only container that publishes 80/443. It overwrites X-Forwarded-For with the address it sees (no
# trusted_proxies is configured: nothing sits in front of it), and the API believes that header only from this
# container's fixed address (PEMA_TRUSTED_PROXIES, see client_ip.py), so a client cannot forge its rate-limit key.
{
	# No admin API: nothing reconfigures this server at runtime, and port 2019 is one less thing to protect.
	admin off

	servers {
		timeouts {
			# slowloris: the request headers must arrive in 10 s, an idle keep-alive connection is dropped at 2 min
			read_header 10s
			idle 2m
		}
	}
}

import mode.caddy

# Reverse proxy to the API. A short retry window hides a container restart (deploy) instead of answering 502
# at once. flush_interval -1: stream the answer as the API writes it (no buffering of long responses).
(to_api) {
	reverse_proxy api:8000 {
		lb_try_duration 15s
		lb_try_interval 250ms
		flush_interval -1
	}
}

{$PEMA_PUBLIC_DOMAIN:localhost} {
	import pema_tls

	encode zstd gzip

	header {
		# hide what runs behind (Caddy, Next.js)
		-Server
		-Via
		-X-Powered-By
		X-Content-Type-Options nosniff
		# the dashboard is never framed (clickjacking); frame-ancestors is the modern form, X-Frame-Options the old one
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# only with a certificate a browser can trust (mode auto); empty in internal and off
		import pema_hsts
	}

	# Access log: who asked for which path and what came back. NOT logged: the query string (it can carry search
	# text, tokens or ids), cookies, Authorization, Set-Cookie, Referer's query.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.* ""
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Referer regexp \?.* ""
			resp_headers>Set-Cookie delete
		}
	}

	# The bridge posts its events to the API over the compose network (http://api:8000), never through here. It
	# authenticates with an HMAC, but there is no reason to leave the route reachable from the internet.
	handle /api/v1/webhooks/zalo-bridge/* {
		respond "Not found" 404
	}

	# Knowledge-base uploads carry documents (KB_MAX_FILE_MB is at most 100): the API cuts them at its own limit,
	# this ceiling only needs to be above it. Every other request body is small JSON and gets the API's own 4 MiB
	# (BodyLimitMiddleware, MAX_BODY_BYTES); Caddy refuses a larger body with 413 before the API reads it.
	@kb_documents path /api/v1/admin/kb/sources/file /api/v1/admin/kb/sources/text
	handle @kb_documents {
		request_body {
			max_size 105MiB
		}
		import to_api
	}

	handle /api/v1/* {
		request_body {
			max_size 4MiB
		}
		import to_api
	}

	handle /healthz {
		import to_api
	}

	handle {
		reverse_proxy frontend:3000 {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
}

# Container health check only (never published): answers while the config is loaded.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /ready "ok" 200
}
