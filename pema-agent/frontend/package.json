{
  "name": "pema-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Pema CSKH agent dashboard (Next.js App Router): clinic operations plus AI administration (port of the zalo-agent dashboard).",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "bun scripts/dev-mock.mjs",
    "mock": "bun mock/main.ts",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../backend/apps/api/openapi.json -o src/lib/api/schema.d.ts",
    "check:types": "tsc --noEmit",
    "shots": "bun scripts/viewport-shots.ts",
    "tokens": "bun scripts/export-tokens.ts",
    "visual": "bun scripts/visual-check.ts",
    "inventory": "bun scripts/inventory-check.ts",
    "check": "bun scripts/check.mjs",
    "smoke": "bun scripts/route-smoke.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "nitro": "^3.0.260903-beta",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
