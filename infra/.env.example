# Copy to infra/.env (never commit it) or generate it with random secrets:  infra/scripts/gen-secrets.sh
# Every value below is a placeholder. Passwords are embedded in URLs: use hex or letters/digits only.
#
# ONE SYSTEM = ONE AGENT. A second installation on the same Docker host needs another COMPOSE_PROJECT_NAME, host
# ports, passwords and domain (prefer another machine).
# COMPOSE_PROJECT_NAME=contete-agent-b

# --- Postgres (docker compose) ----------------------------------------------------------
CONTETE_PG_PORT=5432
CONTETE_PG_SUPERUSER_PASSWORD=change-me-superuser
# Bind address of the published ports. 127.0.0.1 = this machine only (default, safe). To reach a service from
# the other machine set the machine's TAILSCALE IP (100.x.y.z). Never 0.0.0.0 on a machine with a public IP.
CONTETE_PG_BIND=127.0.0.1
# Memory knobs for a 16-32 GB box that also runs the agent; raise shared_buffers on a dedicated DB server.
CONTETE_PG_SHARED_BUFFERS=512MB
CONTETE_PG_EFFECTIVE_CACHE_SIZE=1536MB
# Image tags (pin them for a production box; pgvector tag format is pgNN)
CONTETE_PGVECTOR_TAG=pg17
CONTETE_IMAGE_TAG=local

# The agent's runtime role agent_rt_app (at least 16 characters).
CONTETE_AGENT_RT_APP_PASSWORD=change-me-agent-rt-app
# Seals the Zalo tokens kept by the Zalo connector (service `zalo`). gen-secrets.sh makes a random one.
# Back it up OFFLINE with this file: lose it and every Zalo token must be entered again.
CONTETE_ZALO_SECRET_KEY=change-me-zalo-secret
# The key of the Zalo connector toward the agent (optional, not generated): issue it on the agent's Connectors page
# (Điều khiển agent > Connectors > Thêm; shown ONCE), paste it here, then `docker compose up -d zalo`. Empty: the
# connector idles and logs that it has no key.
ZALO_CONNECTOR_KEY=
# Public address of the connector for Zalo Bot webhooks (optional). Empty = long polling (no inbound port needed).
# Webhook mode needs a proxy route to the connector's /v1/hooks/zalo/bot/<account>, which this stack's Caddy lacks.
ZALO_PUBLIC_URL=

# --- Dashboard ---------------------------------------------------------------------------
CONTETE_FRONTEND_PORT=3000
CONTETE_FRONTEND_BIND=127.0.0.1

# --- Reverse proxy (profile `proxy`, Caddy: infra/caddy/, infra/README.md "Reverse proxy") ----------------------
# Start: docker compose -f infra/docker-compose.yml -f infra/docker-compose.proxy.yml --env-file infra/.env --profile proxy up -d
# Pick ONE of the three modes (CONTETE_PROXY_TLS) and set the matching address (CONTETE_PUBLIC_DOMAIN):
#   auto      real domain pointing at this machine; Caddy gets a Let's Encrypt certificate (needs 80 AND 443 open
#             to the internet, CONTETE_PROXY_BIND=0.0.0.0 or the public IP).   CONTETE_PUBLIC_DOMAIN=clinic.example.com
#   internal  no domain yet; Caddy signs its own certificate (install its CA root on the devices).
#                                                                           CONTETE_PUBLIC_DOMAIN=localhost (or contete.lan)
#   off       plain HTTP, ONLY over Tailscale/WireGuard; also set CONTETE_SESSION_COOKIE_SECURE=false and
#             CONTETE_PROXY_BIND to the Tailscale IP.                          CONTETE_PUBLIC_DOMAIN=http://100.64.0.10
CONTETE_PROXY_TLS=auto
CONTETE_PUBLIC_DOMAIN=localhost
# Loopback by default; the public site needs 0.0.0.0 (or the public IP). Host ports other than 80/443 are for tests.
CONTETE_PROXY_BIND=127.0.0.1
CONTETE_PROXY_HTTP_PORT=80
CONTETE_PROXY_HTTPS_PORT=443
CONTETE_CADDY_TAG=2-alpine
# The `edge` network (Caddy and the frontend only) and Caddy's fixed address on it. Change the three together: the
# IP is inside the subnet and OUTSIDE the range (Docker gives the frontend its address only from the range).
CONTETE_PROXY_SUBNET=172.29.80.0/24
CONTETE_PROXY_IP_RANGE=172.29.80.128/25
CONTETE_PROXY_IP=172.29.80.2
# Secure login cookie (https only). false ONLY for mode `off`.
CONTETE_SESSION_COOKIE_SECURE=true
# --- Backups (scripts/backup-postgres.sh; see the Ubuntu guide, section 10) ---------------------------
# Encrypt with an age PUBLIC key; keep the private key off this machine.
CONTETE_BACKUP_DIR=/var/backups/contete-agent
CONTETE_BACKUP_KEEP_DAYS=14
CONTETE_BACKUP_AGE_RECIPIENT=
CONTETE_BACKUP_GPG_RECIPIENT=
