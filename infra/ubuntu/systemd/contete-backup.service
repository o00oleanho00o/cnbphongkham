# Nightly Postgres backup (HUONG-DAN-UBUNTU.md section 10). Adjust the two paths to where the repository is
# checked out, and create /etc/contete-backup.env (mode 600) with the CONTETE_BACKUP_* variables, for example:
#   CONTETE_BACKUP_DIR=/mnt/backup-disk/contete
#   CONTETE_BACKUP_AGE_RECIPIENT=age1...   (public key; keep the private key off this machine)
#   CONTETE_BACKUP_KEEP_DAYS=14
#   CONTETE_BACKUP_HOOK=/usr/local/bin/contete-offsite.sh   (optional: a script of yours that receives the finished
#                     backup path as $1 and copies it off-site, e.g. rsync to another machine over Tailscale)
#
#   sudo install -m 0644 contete-backup.service contete-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now contete-backup.timer
[Unit]
Description=Contete Agent Postgres backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/contete-backup.env
WorkingDirectory=/opt/cnbphongkham/contete-agent
ExecStart=/opt/cnbphongkham/infra/scripts/backup-postgres.sh
# the dump holds patient data: nobody else reads what we write
UMask=0077
Nice=10
