# LOCAL DEMO ONLY. Read by the root docker-compose.yml (`docker compose up --build` from the repo root) so the whole
# stack starts with no setup. The values are public placeholders: every port below binds to 127.0.0.1 and nothing here
# may be reused for a real installation. A real installation uses `make infra-secrets` (random secrets in infra/.env)
# and the stack of infra/docker-compose.yml on its own.
#
# To use other values without editing this file, set them in the shell (the shell wins over this file).

CONTETE_IMAGE_TAG=local

# Passwords (the compose file builds the connection URLs from them).
CONTETE_PG_SUPERUSER_PASSWORD=local-demo-pg-superuser
CONTETE_AGENT_RT_APP_PASSWORD=local-demo-agent-rt-app
# Seals the Zalo tokens of the Zalo connector (a placeholder, not for real use).
CONTETE_ZALO_SECRET_KEY=local-demo-zalo-secret-key-not-for-real-use

# Host ports, loopback only. Postgres uses an unusual port so it does not collide with a local install.
CONTETE_PG_BIND=127.0.0.1
CONTETE_PG_PORT=15432
CONTETE_FRONTEND_BIND=127.0.0.1
CONTETE_FRONTEND_PORT=3000
