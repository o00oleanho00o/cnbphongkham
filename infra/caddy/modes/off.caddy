# TLS mode `off` (CONTETE_PROXY_TLS=off): plain HTTP, for a link that is already encrypted end to end (Tailscale or
# WireGuard only). Set CONTETE_PUBLIC_DOMAIN to `http://<tailscale-ip-or-name>` (the http:// prefix turns TLS and the
# redirect off), CONTETE_PROXY_BIND to the Tailscale IP of this machine (never 0.0.0.0) and CONTETE_SESSION_COOKIE_SECURE
# to false: a Secure cookie is not sent over http, so the login would loop. Never use this on the public internet.

(contete_tls) {
	# empty on purpose: no TLS
}

(contete_hsts) {
	# empty on purpose
}
