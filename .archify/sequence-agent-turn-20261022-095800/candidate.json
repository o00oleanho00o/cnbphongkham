  "cards": [
    {
      "dot": "cyan",
      "title": "Lưu trước, chạy sau",
      "items": [
        "Tin đến được ghi vào agent_ingress trước khi xử lý; tiến trình chết thì sweeper nhặt lại",
        "Mỗi tin assistant ghi trước khi tool chạy, nên lịch sử gửi lại nhà cung cấp luôn hợp lệ"
      ]
    },
    {
      "dot": "rose",
      "title": "Cái gì chặn, cái gì chỉ nhắc",
      "items": [
        "pre_tool: hook lỗi hay quá giờ là chặn tool (fail closed)",
        "post_tool, before_model: hook lỗi thì bỏ qua và ghi log (fail open)",
        "Lõi có 3 hook: quét prompt injection, che bí mật, cảnh báo kết quả tool"
      ]
    },
    {
      "dot": "amber",
      "title": "Kết thúc lượt",
      "items": [
        "Model trả lời không gọi tool, hoặc hết max_steps (10), hết 300 s, hết token, hay loop guard dừng",
        "Khi đó một lời gọi cuối không có tool ép ra câu trả lời",
        "Lượt lỗi: kênh vẫn nhận failure_reply của profile"
      ]
    }
  ]
