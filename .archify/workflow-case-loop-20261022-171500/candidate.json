  "cards": [
    {
      "dot": "cyan",
      "title": "Ba tầng, một chiều",
      "items": [
        "agentcore.cases chỉ có hình và luật thuần, không biết DB, model hay plugin nào",
        "Động cơ ở agent_app chạy mọi ca như nhau; nội dung (goal, state, nút, cạnh, luật dừng) do plugin khai báo qua register_case",
        "Hai tool điều khiển chỉ có khi một plugin đang bật khai báo ca"
      ]
    },
    {
      "dot": "amber",
      "title": "Cái gì chặn vòng quay mãi",
      "items": [
        "Ca chờ (khách hay giờ) nằm trong agent_case; khách nhắn, tới wake_at hoặc plugin gọi wake thì quay lại Thức",
        "Cạnh quay lại bắt buộc có bộ đếm với trần; tới trần thì ca dừng",
        "Trước mỗi nút: công tắc cases_enabled, hạn max_age, trần lượt và tin của ca, trần tin mỗi người mỗi ngày (cộng mọi ca)",
        "Khách nhắn kiểu 'đừng nhắn nữa' (stop_if) dừng ca trước khi chạy nút nào"
      ]
    },
    {
      "dot": "rose",
      "title": "Không chạy hai lần",
      "items": [
        "Một ca sống mỗi (plugin, kind, key); lưu chỉ thắng khi version còn đúng, bên thua ghi 'lost'",
        "Lượt model vào hàng đợi với mã case:id:lượt, nên chạy đúng một lần và giữ khóa phiên như mọi tin",
        "Động cơ không cầm khóa phiên: lượt cầm, cầm trước là tự khóa mình"
      ]
    }
