  "cards": [
    {
      "dot": "cyan",
      "title": "Khi nào nén",
      "items": [
        "Trước một lời gọi: yêu cầu ước lượng vượt 75% của (128k − max_output_tokens) → nén rồi dựng lại yêu cầu",
        "Nhà cung cấp trả context_overflow: nén mạnh (chỉ giữ lượt hiện tại), thử đúng một lần nữa",
        "Mốc cắt luôn là một tin user bắt đầu lượt, nên tool call không bao giờ tách khỏi kết quả"
      ]
    },
    {
      "dot": "amber",
      "title": "Kho giữ gì",
      "items": [
        "agent_message giữ mọi tin; nén không xóa gì, chỉ ghi summary và first_kept vào agent_session",
        "Tóm tắt sau gộp tóm tắt trước; tóm tắt lỗi thì chỉ còn dòng 'Earlier messages were removed…'",
        "Trong agent chat không có DB thì mọi thứ ở bộ nhớ tiến trình; /compact ép nén bằng tay"
      ]
    },
    {
      "dot": "rose",
      "title": "Ghi chú là thứ sống qua phiên",
      "items": [
        "flush_memory: model đọc đoạn sắp bỏ với FLUSH_NOTE, được 2 lời gọi chỉ có tool memory; lỗi model thì bỏ qua",
        "injection_guard chặn ghi chú giống lệnh; MemoryService từ chối khi quá cap hay khi phiên khác vừa ghi (3 lần thử)",
        "Ghi chú vào system prompt ở lần dựng lại (sau nén) hay phiên mới; system prompt đóng băng nên cache của nhà cung cấp còn dùng được"
      ]
    }
  ]
