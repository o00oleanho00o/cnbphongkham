  "cards": [
    {
      "dot": "cyan",
      "title": "Hai cột trạng thái trên một hàng",
      "items": [
        "status (queued → processing → done | failed | dead): lượt của agent có chạy được không",
        "delivery (pending → sending → sent | failed | skipped, hoặc NULL): trả lời có tới kênh không",
        "Cả hai nằm trong agent_rt.agent_ingress; mọi tiến trình của agent đọc cùng bảng, nên tin không mất khi một tiến trình chết",
        "Chi tiết trạng thái: queued ghi một lần mỗi message_id của kênh; done luôn kèm reply (text, stop, steps, usage); failed giữ error_kind; dead là bị bỏ dở 3 lần (interrupted); http: delivery NULL nên gateway tự đọc reply; skipped: gộp với tin khác, SKIP, trả lời rỗng, kênh từ chối hay không kịp; delivery failed: hết 4 lần hay lỗi không thử lại được (bị chặn, chat đã xóa)"
      ]
    },
    {
      "dot": "amber",
      "title": "Ai làm gì",
      "items": [
        "Dispatcher: accept, drain (khóa advisory Postgres theo phiên), sweeper 30 s",
        "ChannelHub: tick 2 s tìm trả lời đến lượt, gửi từng phần theo max_text_chars của kênh, 16 gửi song song",
        "Gateway: tin HTTP không có delivery; client gọi /v1/ingress/{id} hay nhận SSE"
      ]
    },
    {
      "dot": "rose",
      "title": "Không bao giờ",
      "items": [
        "Một trả lời của phiên không vượt qua trả lời trước nó (NOT EXISTS earlier pending/sending)",
        "Một message_id của kênh không chạy hai lần (UNIQUE tenant, agent, channel, external_id)",
        "Một tin của người khác trong nhóm không bị gộp vào lượt của người đang nói"
      ]
    },
    {
      "dot": "emerald",
      "title": "Điều kiện trên từng mũi tên",
      "items": [
        "claim: cùng phiên một lượt một lúc; collect/steer gom thêm tin của cùng người trước khi claim",
        "sweeper (30 s): tin processing mà khóa phiên đang rảnh (tiến trình chạy nó đã chết) về queued; lần thứ 3 thành dead (error_kind interrupted)",
        "deliver: kênh chat đặt deliver=True; HTTP để NULL nên gateway tự đọc reply",
        "failure_reply: lượt lỗi vẫn gửi câu xin lỗi của profile; tin PROACTIVE lỗi thì skipped, không xin lỗi",
        "tới lượt: claim_delivery chỉ khi không còn trả lời trước đó của cùng phiên đang pending/sending",
        "lỗi tạm, bỏ dở: lùi 2 / 10 / 60 s; sending quá 120 s coi là tiến trình chết, tiến trình khác lấy lại (gửi ít nhất một lần)",
        "4 lần, vĩnh viễn: hết delivery_attempts hay ChannelSendError(retryable=False)"
      ]
    }
  ]
